# ============================================================
# DOUTOR IMIGRANTE — secrets das Edge Functions (Deno)
#
# Local: copie para supabase/functions/.env (fora do git) e rode
#   supabase functions serve --env-file supabase/functions/.env
# Produção: painel do Supabase → Edge Functions → Secrets
#   (ou `supabase secrets set NOME=valor`). Nunca commite valores reais.
#
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY e SUPABASE_DB_URL
# são injetadas pelo próprio Supabase (local e produção): não declare aqui.
#
# Sem as chaves da OpenAI, do Stripe e do Resend, as functions respondem com
# erro de configuração — é o esperado no desenvolvimento local e no CI, que
# nunca chamam serviços pagos. Use só chaves de TESTE do Stripe (sk_test_…).
#
# Conferência código × exemplo: npm run check-env
# ============================================================

# ── App ────────────────────────────────────────────────────────
# Origem do front: CORS e links dos e-mails. Produção: https://www.drimigrante.com
APP_URL=http://localhost:33401
# Segredo entre functions (stripe-webhook e generate-explanation chamam o send-email).
# Gere com: openssl rand -hex 32
INTERNAL_SECRET=
# Opcional: origens extras para o CORS, separadas por vírgula (origens exatas,
# ex.: https://staging.drimigrante.com). Produção, APP_URL, previews da Vercel e
# localhost já são permitidos (supabase/functions/_shared/cors.ts).
CORS_ALLOWED_ORIGINS=

# ── Sentry do backend (opcional) ───────────────────────────────
# Sem o DSN, nada é enviado: só ficam os logs do Supabase.
# Ver docs/operacao/runbook-pagamentos.md, seção 8.
SENTRY_DSN_BACKEND=
# Padrão: production no projeto de produção, development fora dele.
SENTRY_ENVIRONMENT=
# Versão (ex.: SHA do commit) para agrupar os erros por deploy.
SENTRY_RELEASE=

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret do endpoint do webhook (painel do Stripe → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Price IDs: pagamento único de €30 e assinatura de €4,90/mês.
STRIPE_PRICE_ONE_TIME=
STRIPE_PRICE_RECURRING=
# Opcional: idioma do Stripe Checkout (padrão pt-BR). Ex.: pt, en, es, auto.
# Valor fora da lista do Stripe volta para pt-BR (create-checkout-session/checkout-options.ts).
STRIPE_LOCALE=
# Opcional: mostra o campo de código promocional no Checkout (padrão: oculto).
# Use true só durante uma campanha com códigos criados no painel do Stripe.
STRIPE_ALLOW_PROMOTION_CODES=

# ── OpenAI (análise e chat) ────────────────────────────────────
OPENAI_API_KEY=
# Opcional: teto de gerações de análise por hora na plataforma toda (padrão 60).
AI_HOURLY_CAP=

# ── Resend (e-mail) ────────────────────────────────────────────
RESEND_API_KEY=
# Opcional: remetente (padrão "Doutor Imigrante <noreply@mail.drimigrante.com>").
EMAIL_FROM=

# ── e2e-login: SÓ Supabase local ou staging, NUNCA produção ────
# `npm run supabase:functions:e2e` gera estes valores sozinho (aleatórios).
# Em produção a function não existe e estas variáveis não podem ser criadas.
E2E_MODE=
E2E_LOGIN_SECRET=
