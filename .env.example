# ============================================================
# DOUTOR IMIGRANTE — variáveis do FRONT (Vite)
#
# Copie para .env.local e preencha. Nunca commite .env.local.
# Desenvolvimento com Supabase local: `npm run supabase:env` grava
# .env.development.local sozinho (veja o README.md).
#
# Tudo que começa com VITE_ vai para o navegador: aqui só entram URL e chave
# anon do Supabase e IDs PÚBLICOS. Service role, chaves do Stripe, da OpenAI e
# do Resend NUNCA entram aqui — elas ficam nos secrets das Edge Functions
# (supabase/functions/.env.example).
#
# Validação: src/lib/env.ts. Conferência código × exemplos: npm run check-env
# ============================================================

# ── Supabase (obrigatórias) ───────────────────────────────────
# Painel do Supabase → Project Settings → API. Local: http://127.0.0.1:54321
VITE_SUPABASE_URL=
# Chave anon/publishable (nunca a service_role).
VITE_SUPABASE_ANON_KEY=
# Opcional: endereço das Edge Functions, se diferente de <VITE_SUPABASE_URL>/functions/v1.
VITE_SUPABASE_FUNCTIONS_URL=

# ── App ────────────────────────────────────────────────────────
# URL pública do front (links de login por e-mail). Local: http://localhost:33401
VITE_APP_URL=http://localhost:33401
# development | preview | production (produção também é detectada pelo domínio).
VITE_APP_ENV=development
# true = login por código de 6 dígitos no /login (exige o template de e-mail com {{ .Token }}).
VITE_AUTH_EMAIL_CODE=

# ── Analytics e monitoramento (opcionais) ─────────────────────
# Analytics só rodam em produção; o Sentry, em produção e nos previews.
# Nenhum dos dois roda em localhost nem no Playwright (src/lib/runtime-env.ts).
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GA_MEASUREMENT_ID=
# Meta Pixel: só carrega com consentimento de marketing.
VITE_META_PIXEL_ID=
