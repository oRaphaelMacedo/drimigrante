# ============================================================
# DOUTOR IMIGRANTE — variáveis dos testes E2E (Playwright)
#
# O arquivo real é o .env.test.local (ignorado pelo git). Gere-o com:
#   npm run supabase:start   # sobe o Supabase local
#   npm run supabase:env     # grava URL e chaves LOCAIS em .env.test.local
#
# O Playwright lê SÓ este arquivo e o ambiente — nunca o .env.local — e recusa
# o Supabase de produção e qualquer host remoto fora de E2E_ALLOWED_REMOTE_HOSTS.
# Detalhes em "Testes" no README.md.
# ============================================================

# ── Supabase local (saída de `supabase status -o env`) ────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Só para os fixtures que preparam dados (e2e/fixtures/seeded.ts) e para a
# limpeza (e2e/global-teardown.ts). Use SEMPRE a chave do stack local.
SUPABASE_SERVICE_ROLE_KEY=

# ── Testes autenticados (parte autenticada do spec 04 e spec 05) ──
# Ficam em skip sem E2E_LOGIN_SECRET e INTERNAL_SECRET (o spec 05 também exige
# SUPABASE_SERVICE_ROLE_KEY). Exigem a e2e-login servida localmente:
# `npm run supabase:functions:e2e` gera os dois valores (aleatórios, só locais).
E2E_LOGIN_SECRET=
INTERNAL_SECRET=
# Opcional: endereço da e2e-login, se ela não estiver em <VITE_SUPABASE_URL>/functions/v1.
E2E_LOGIN_URL=

# ── Modo (opcional) ───────────────────────────────────────────────
# local (padrão) = Supabase local. mock = só os testes do spec 06 que mockam o
# Supabase inteiro, com um host fictício (npm run test:e2e:mock). No modo mock
# este arquivo não é lido e nenhuma credencial é usada.
E2E_SUPABASE=

# ── Front externo (opcional) ──────────────────────────────────────
# Vazio = o Playwright sobe o Vite em http://localhost:33401 com as variáveis acima.
E2E_BASE_URL=
# Porta do Vite do teste (padrão 33401). Use outra se o seu `npm run dev` já ocupa a 33401.
E2E_PORT=
# 1 = reaproveitar um dev server já aberto nessa porta (só se ele apontar para o Supabase local).
E2E_REUSE_SERVER=

# ── Staging (opcional) ────────────────────────────────────────────
# Hosts remotos permitidos, separados por vírgula (ex.: <ref-de-staging>.supabase.co).
# O projeto e os domínios de produção são recusados mesmo se listados aqui.
E2E_ALLOWED_REMOTE_HOSTS=
